NEXT_PUBLIC_SITE_URL=https://singhbuildstech.com

NOTION_KEY=ntn_your_private_installation_token
NOTION_DATABASE_ID=your_articles_database_id
NOTION_CONTACT_FORM_DATABASE_ID=your_contact_database_id

NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
GOOGLE_RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Optional: omit this variable to disable Google Analytics and its consent prompt.
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX

# Private Google-authenticated author workspace. See docs/ARTICLE_PUBLISHING.md.
ADMIN_EMAIL=singhbuildstech@gmail.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
NEXTAUTH_SECRET=replace_with_a_generated_random_secret
NEXTAUTH_URL=http://localhost:3000

# Optional: enables royalty-free cover-image search in the private editor.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
